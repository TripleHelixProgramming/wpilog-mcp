      "datasource": {
        "type": "prometheus",
        "uid": "pit-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nt_value{job=\"pit\",topic=\"$battery_topic\"}",
          "legendFormat": "{{topic}} {{field}} {{index}} {{robot}}",
          "range": true
