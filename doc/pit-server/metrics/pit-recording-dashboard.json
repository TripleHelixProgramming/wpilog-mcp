{
  "uid": "wpilog-pit-recording",
  "title": "Pit recording",
  "tags": [
    "wpilog-mcp"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "editable": true,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "battery_entry",
        "label": "Battery entry (volts)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0,
        "description": "The entry as the capture names it: NT: and the topic for a robot topic, such as NT:/SmartDashboard/Battery."
      },
      {
        "name": "can_entry",
        "label": "CAN utilization entry (fraction)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0,
        "description": "The entry as the capture names it: NT: and the topic for a robot topic, such as NT:/SmartDashboard/Battery."
      },
      {
        "name": "loop_entry",
        "label": "Loop duration entry (seconds)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0,
        "description": "The entry as the capture names it: NT: and the topic for a robot topic, such as NT:/SmartDashboard/Battery."
      },
      {
        "name": "cpu_entry",
        "label": "Robot CPU entry (fraction)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
