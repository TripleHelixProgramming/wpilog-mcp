        "hide": 0,
        "description": "The entry as the capture names it: NT: and the topic for a robot topic, such as NT:/SmartDashboard/Battery."
      },
      {
        "name": "disk_entry",
        "label": "Robot free disk entry (bytes)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0,
        "description": "The entry as the capture names it: NT: and the topic for a robot topic, such as NT:/SmartDashboard/Battery."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Reading this dashboard",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Every value the open capture recorded, read from its file by measured UTC. Each panel is one entry: the band runs from each bucket's minimum to its maximum, the line is its mean, and zooming in narrows the buckets until every sample shows. The window reaches back no further than the open file.\n\nFill the boxes with entries exactly as the capture names them, in the units each box states. A panel the server refuses shows only its status code: **404** means nothing is recording or the box names no entry of the capture, **422** means the recording cannot be placed in UTC yet, and **400** means a box is empty or names something that is not a number. The sampled dashboard shows whether a session is open."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Battery",
      "description": "Every value the open capture recorded for this entry: a band from each bucket's minimum to its maximum, with its mean. Zoom in until every sample shows.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "pit-recording"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "pit-recording"
          },
          "type": "csv",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/data/entries",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "capture",
                "value": "current"
              },
              {
                "key": "names",
                "value": "$battery_entry"
              },
              {
                "key": "format",
                "value": "csv"
              },
              {
                "key": "start_utc",
                "value": "${__from:date:iso}"
              },
              {
                "key": "end_utc",
                "value": "${__to:date:iso}"
              },
              {
                "key": "max_points",
                "value": "1000"
              }
            ]
          },
          "csv_options": {
            "comment": "#"
          },
          "columns": [
            {
              "selector": "timestamp_utc",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "min",
              "text": "min",
              "type": "number"
            },
            {
              "selector": "max",
              "text": "max",
              "type": "number"
            },
            {
              "selector": "mean",
              "text": "mean",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "min"
              },
              {
                "id": "custom.fillOpacity",
                "value": 25
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "min"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mean"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
