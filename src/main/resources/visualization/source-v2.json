{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WPILog source reference v2",
  "type": "object",
  "properties": {
    "schema_version": { "enum": [2] },
    "server_instance_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "content": {
      "oneOf": [
        { "$ref": "contracts-v1.json#/$defs/source_ref" },
        {
          "type": "object",
          "properties": {
            "kind": { "enum": ["file_version"] },
            "master_store_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 36 },
            "file_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 36 },
            "file_version": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 36 }
          },
          "required": ["kind", "master_store_id", "file_id", "file_version"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["schema_version", "server_instance_id", "scope_id", "content"],
  "additionalProperties": false
}
